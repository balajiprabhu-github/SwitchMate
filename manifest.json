{
  "manifest_version": 3,
  "name": "SwitchMate - Interview & Focus Companion",
  "version": "1.0.0",
  "description": "Stay accountable to your daily goals, track site usage, block LinkedIn doom-scrolling, and ace your Android developer interviews.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SwitchMate Goals & Focus"
  },
  "options_page": "options/options.html",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "idle",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.linkedin.com/*"],
      "js": ["content/linkedin-shield.js"],
      "css": ["content/linkedin-shield.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["utils/gemini-nano.js", "content/nudge.js"],
      "css": ["content/nudge.css"],
      "run_at": "document_idle"
    }
  ]
}
